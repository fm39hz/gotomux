{
  "branches": ["master"],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "angular",
        "parserOpts": {
          "headerPattern": "^(\\w*)(?:\\((.*)\\))?!?: (.*)$",
          "breakingHeaderPattern": "^(\\w*)(?:\\((.*)\\))?!: (.*)$"
        }
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "angular",
        "parserOpts": {
          "headerPattern": "^(\\w*)(?:\\((.*)\\))?!?: (.*)$",
          "breakingHeaderPattern": "^(\\w*)(?:\\((.*)\\))?!: (.*)$"
        }
      }
    ],
    ["@semantic-release/github", { "assets": ["gotomux", "gotomuxd"] }]
  ]
}